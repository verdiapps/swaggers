							}
						}
					},
					"400": {
						"description": "No previous user available",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					},
					"401": {
						"description": "Unauthorized - Missing or invalid access token",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					},
					"403": {
						"description": "Forbidden: can't refresh tokens or can't switch previous user",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					},
					"404": {
						"description": "Initial user not found, user not found, switch info not found, user not found in switch, or previous user not found",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					}
				},
				"security": [
					{
						"cookieAuth": []
					}
				]
			}
		},
		"/users/by-addresses": {
			"post": {
				"tags": ["User Management"],
				"summary": "Get users by wallet addresses",
				"description": "Retrieves users based on their wallet addresses. Requires admin privileges. Returns users that match any of the provided addresses.",
				"operationId": "getUsersByAddresses",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/GetUsersByAddressesRequest"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "List of users matching the provided addresses",
						"content": {
							"application/json": {
								"schema": {
									"type": "array",
									"items": {
										"$ref": "#/components/schemas/UserResponse"
									}
								}
							}
						}
					},
					"400": {
						"description": "Validation error - Invalid request body",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ValidationErrorResponse"
								}
							}
						}
					},
					"401": {
						"description": "Unauthorized - Missing or invalid authentication token",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					},
					"500": {
						"description": "Failed to fetch users by addresses",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					}
				},
				"security": [
					{
						"cookieAuth": []
					}
				]
			}
		},
		"/avatar": {
			"post": {
				"tags": ["Avatar"],
				"summary": "Upload user avatar",
				"description": "Upload an avatar image for the authenticated user. The image is converted to AVIF format, a thumbhash is computed, and width/height are extracted. If an existing avatar is present, it will be replaced. Requires authentication via Bearer token or accessToken cookie.",
				"operationId": "uploadAvatar",
				"security": [
					{
						"cookieAuth": [],
						"bearerAuth": []
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"multipart/form-data": {
							"schema": {
								"type": "object",
								"properties": {
									"file": {
										"type": "string",
										"format": "binary",
										"description": "Image file to upload (must have an image/* MIME type)"
									}
								},
								"required": ["file"]
							},
							"encoding": {
								"file": {
									"contentType": "image/*"
								}
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Avatar uploaded and processed successfully",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/AvatarResponse"
								}
							}
						}
					},
					"400": {
						"description": "Bad request — invalid multipart request, non-image MIME type, no file present, or upload error",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					},
					"401": {
						"description": "Unauthorized — missing or invalid access token",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					},
					"499": {
						"description": "Request aborted by the client",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					}
				}
			},
			"delete": {
				"tags": ["Avatar"],
				"summary": "Delete user avatar",
				"description": "Delete the authenticated user's avatar. Removes both the database record and the file from storage. Requires authentication.",
				"operationId": "deleteAvatar",
				"security": [
					{
						"cookieAuth": [],
						"bearerAuth": []
					}
				],
				"responses": {
