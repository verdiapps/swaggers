{
	"openapi": "3.1.0",
	"info": {
		"title": "Meals Service API",
		"version": "1.0.0",
		"description": "API for managing meals."
	},
	"servers": [
		{
			"url": "/api",
			"description": "Main API server"
		}
	],
	"components": {
		"schemas": {
			"SuccessMessage": {
				"type": "object",
				"properties": {
					"message": {
						"type": "string",
						"example": "Operation successful"
					}
				}
			},
			"ErrorResponse": {
				"type": "object",
				"properties": {
					"message": {
						"type": "string",
						"description": "Error message detailing what went wrong",
						"example": "Invalid input"
					},
					"statusCode": {
						"type": "integer",
						"description": "HTTP status code",
						"example": 400
					},
					"statusMessage": {
						"type": "string",
						"description": "HTTP status message",
						"example": "Bad Request"
					},
					"data": {
						"type": "object",
						"description": "Additional error data, often contains validation issues"
					}
				}
			},
			"DynamicRecommendation": {
				"type": "object",
				"properties": {
					"ingredientId": {
						"type": "string"
					},
					"consumedGrams": {
						"type": "number"
					},
					"originalRecommendedGrams": {
						"type": "number"
					},
					"adjustedRecommendedGrams": {
						"type": "number"
					},
					"originalCalories": {
						"type": "number"
					},
					"adjustedCalories": {
						"type": "number"
					},
					"consumptionPercentage": {
						"type": "number"
					},
					"isOverRecommended": {
						"type": "boolean"
					},
					"isDisabled": {
						"type": "boolean"
					}
				},
				"required": [
					"ingredientId",
					"consumedGrams",
					"originalRecommendedGrams",
					"adjustedRecommendedGrams",
					"originalCalories",
					"adjustedCalories",
					"consumptionPercentage",
					"isOverRecommended"
				]
			},
			"Category": {
				"type": "object",
				"properties": {
					"_id": {
						"type": "string",
						"description": "Unique identifier for the category (MongoDB ObjectId)",
						"readOnly": true,
						"example": "605c72ef29592b001c000001"
					},
					"userId": {
						"type": "string",
						"description": "Identifier of the user who owns the category",
						"example": "605c72ef29592b001c000001",
						"pattern": "^[0-9a-fA-F]{24}$"
					},
					"templateId": {
						"type": "string",
						"description": "Identifier of the template this category belongs to",
						"example": "605c72ef29592b001c000000",
						"pattern": "^[0-9a-fA-F]{24}$"
					},
					"name": {
						"type": "string",
						"description": "Name of the category",
						"example": "Breakfast"
					},
					"createdAt": {
						"type": "string",
						"format": "date-time",
						"description": "Timestamp of when the category was created",
						"readOnly": true
					},
					"updatedAt": {
						"type": "string",
						"format": "date-time",
						"description": "Timestamp of when the category was last updated",
						"readOnly": true
					}
				},
				"required": ["_id", "userId", "name", "createdAt", "updatedAt"]
			},
			"CategoryInput": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string",
						"description": "Name of the category",
						"minLength": 1,
						"example": "Lunch"
					},
					"templateId": {
						"type": "string",
						"description": "Identifier of the template this category belongs to",
						"example": "605c72ef29592b001c000000",
						"pattern": "^[0-9a-fA-F]{24}$"
					}
				},
				"required": ["name"]
			},
			"CategoryUpdateInput": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string",
						"description": "Name of the category (optional for update)",
						"minLength": 1,
						"example": "Quick Lunch"
					},
					"templateId": {
						"type": "string",
						"description": "Identifier of the template this category belongs to (optional for update)",
						"example": "605c72ef29592b001c000000",
						"pattern": "^[0-9a-fA-F]{24}$"
					}
				}
			},
			"CategoryCreationResponse": {
				"type": "object",
				"properties": {
					"message": {
						"type": "string",
						"example": "Item added successfully"
					},
					"data": {
						"$ref": "#/components/schemas/Category"
					}
				}
			},
			"CategoryUpdateResponse": {
				"type": "object",
				"properties": {
					"message": {
						"type": "string",
						"example": "Item updated successfully"
					},
					"category": {
						"$ref": "#/components/schemas/Category"
					}
				}
			},
			"CategoryWithIngredients": {
				"allOf": [
					{
						"$ref": "#/components/schemas/Category"
					},
					{
						"type": "object",
						"properties": {
							"ingredients": {
								"type": "array",
								"items": {
									"$ref": "#/components/schemas/Ingredient"
								}
							}
						}
					}
				]
			},
			"Ingredient": {
				"type": "object",
				"properties": {
					"_id": {
						"type": "string",
						"description": "Unique identifier for the ingredient (MongoDB ObjectId)",
						"readOnly": true,
						"example": "605c72ef29592b001c000002"
					},
					"userId": {
						"type": "string",
						"description": "Identifier of the user who owns the ingredient",
						"example": "user123"
					},
					"categoryId": {
						"type": "string",
						"description": "Identifier of the category this ingredient belongs to",
						"example": "605c72ef29592b001c000001"
					},
					"name": {
						"type": "string",
						"description": "Name of the ingredient",
						"example": "Chicken Breast"
					},
					"calories": {
						"type": "number",
						"format": "float",
						"description": "Calories per 100g",
						"example": 165
					},
					"proteins": {
						"type": "number",
						"format": "float",
						"description": "Proteins per 100g",
						"example": 31
					},
					"fats": {
						"type": "number",
						"format": "float",
						"description": "Fats per 100g",
						"default": 0,
						"example": 3.6
					},
					"carbs": {
						"type": "number",
						"format": "float",
						"description": "Carbohydrates per 100g",
						"default": 0,
						"example": 0
					},
					"grams": {
						"type": "number",
						"format": "float",
						"description": "Grams of the ingredient",
						"example": 100
					},
					"isAlcohol": {
						"type": "boolean",
						"description": "Whether the ingredient is alcoholic",
						"default": false
					},
					"unit": {
						"type": "string",
						"description": "Unit of measurement for the ingredient",
						"enum": ["grams", "pieces"],
						"default": "grams"
					},
					"createdAt": {
						"type": "string",
						"format": "date-time",
						"description": "Timestamp of when the ingredient was created",
						"readOnly": true
					},
					"updatedAt": {
						"type": "string",
						"format": "date-time",
						"description": "Timestamp of when the ingredient was last updated",
						"readOnly": true
					}
				},
				"required": [
					"_id",
					"userId",
					"categoryId",
					"name",
					"calories",
					"proteins",
					"grams",
					"isAlcohol",
					"unit",
					"createdAt",
					"updatedAt"
				]
			},
			"IngredientInput": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string",
						"description": "Name of the ingredient",
						"minLength": 1,
						"example": "Raw Salmon"
					},
					"calories": {
						"type": "number",
						"format": "float",
						"description": "Calories per 100 grams",
						"minimum": 0,
						"example": 208
					},
					"proteins": {
						"type": "number",
						"format": "float",
						"description": "Proteins per 100 grams",
						"minimum": 0,
						"example": 20
					},
					"fats": {
						"type": "number",
						"format": "float",
						"description": "Fats per 100 grams",
						"minimum": 0,
						"default": 0,
						"example": 13
					},
					"carbs": {
						"type": "number",
						"format": "float",
						"description": "Carbohydrates per 100 grams",
						"minimum": 0,
						"default": 0,
						"example": 0
					},
					"grams": {
						"type": "number",
						"format": "float",
						"description": "Weight in grams",
						"minimum": 0,
						"example": 100
					},
					"isAlcohol": {
						"type": "boolean",
						"description": "Whether the ingredient is alcoholic",
						"default": false
					},
					"unit": {
						"type": "string",
						"description": "Unit of measurement for the ingredient",
						"enum": ["grams", "pieces"],
						"default": "grams"
					},
					"categoryId": {
						"type": "string",
						"description": "Identifier of the category this ingredient belongs to",
						"example": "605c72ef29592b001c000000",
						"pattern": "^[0-9a-fA-F]{24}$"
					}
				},
				"required": ["name", "calories", "proteins", "grams", "categoryId"]
			},
			"IngredientUpdateInput": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string",
						"description": "Name of the ingredient (optional for update)",
						"minLength": 1,
						"example": "Cooked Salmon"
					},
					"calories": {
						"type": "number",
						"format": "float",
						"description": "Calories per 100 grams (optional for update)",
						"minimum": 0,
						"example": 220
					},
					"proteins": {
						"type": "number",
						"format": "float",
						"description": "Proteins per 100 grams (optional for update)",
						"minimum": 0,
						"example": 22
					},
					"fats": {
						"type": "number",
						"format": "float",
						"description": "Fats per 100 grams (optional for update)",
						"minimum": 0,
						"example": 14
					},
					"carbs": {
						"type": "number",
						"format": "float",
						"description": "Carbohydrates per 100 grams (optional for update)",
						"minimum": 0,
						"example": 0
					},
					"grams": {
						"type": "number",
						"format": "float",
						"description": "Weight in grams (optional for update)",
						"minimum": 0,
						"example": 120
					},
					"isAlcohol": {
						"type": "boolean",
						"description": "Whether the ingredient is alcoholic",
						"example": false
					},
					"unit": {
						"type": "string",
						"description": "Unit of measurement for the ingredient",
						"enum": ["grams", "pieces"],
						"default": "grams"
					},
					"categoryId": {
						"type": "string",
						"description": "Identifier of the category this ingredient belongs to (optional for update)",
						"example": "605c72ef29592b001c000000",
						"pattern": "^[0-9a-fA-F]{24}$"
					}
				}
			},
			"IngredientCreationResponse": {
				"type": "object",
				"properties": {
					"message": {
						"type": "string",
						"example": "Item added successfully"
					},
					"data": {
						"$ref": "#/components/schemas/Ingredient"
					}
				}
			},
			"IngredientUpdateResponse": {
				"type": "object",
				"properties": {
					"ingredient": {
						"$ref": "#/components/schemas/Ingredient"
					}
				}
			},
			"IngredientWithCategory": {
				"allOf": [
					{
						"$ref": "#/components/schemas/Ingredient"
					},
					{
						"type": "object",
						"properties": {
							"category": {
								"$ref": "#/components/schemas/Category"
							}
						}
					}
				]
			},
			"MongoDeleteResult": {
				"type": "object",
				"properties": {
					"acknowledged": {
						"type": "boolean",
						"example": true
					},
					"deletedCount": {
						"type": "integer",
						"example": 1
					}
				},
				"required": ["acknowledged", "deletedCount"]
			},
			"Set": {
				"type": "object",
				"properties": {
					"_id": {
						"type": "string",
						"description": "Unique identifier for the set",
						"readOnly": true
					},
					"userId": {
						"type": "string"
					},
					"ingredients": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"id": {
									"type": "string"
								},
								"value": {
									"type": "number"
								}
							},
							"required": ["id", "value"]
						}
					},
					"createdAt": {
						"type": "string",
						"format": "date-time"
					},
					"updatedAt": {
						"type": "string",
						"format": "date-time"
					}
				},
				"required": ["_id", "userId", "ingredients", "createdAt", "updatedAt"]
			},
			"SetInput": {
				"type": "object",
				"properties": {
					"ingredients": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"id": {
									"type": "string"
								},
								"value": {
									"type": "number"
								}
							},
							"required": ["id", "value"]
						}
					}
				},
				"required": ["ingredients"]
			},
			"SetUpdateInput": {
				"type": "object",
				"properties": {
					"ingredients": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"id": {
									"type": "string"
								},
								"value": {
									"type": "number"
								}
							},
							"required": ["id", "value"]
						}
					}
				}
			},
			"SetCreationResponse": {
				"type": "object",
				"properties": {
					"message": {
						"type": "string"
					},
					"data": {
						"$ref": "#/components/schemas/Set"
					}
				}
			},
			"SetUpdateResponse": {
				"type": "object",
				"properties": {
					"message": {
						"type": "string"
					},
					"data": {
						"$ref": "#/components/schemas/Set"
					}
				}
			},
			"SetResponse": {
				"allOf": [
					{
						"$ref": "#/components/schemas/Set"
					},
					{
						"type": "object",
						"properties": {
							"ingredients": {
								"type": "array",
								"items": {
									"type": "object",
									"properties": {
										"id": {
											"type": "string"
										},
										"value": {
											"type": "number"
										},
										"name": {
											"type": "string"
										},
										"categoryId": {
											"type": "string"
										},
										"categoryName": {
											"type": "string"
										},
										"calories": {
											"type": "number"
										},
										"proteins": {
											"type": "number"
										},
										"grams": {
											"type": "number"
										}
									}
								}
							}
						}
					}
				]
			},
			"SetDeleteResponse": {
				"type": "object",
				"properties": {
					"message": {
						"type": "string"
					}
				}
			},
			"Template": {
				"type": "object",
				"properties": {
					"_id": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"userId": {
						"type": "string"
					},
					"createdAt": {
						"type": "string",
						"format": "date-time"
					},
					"categories": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/CategoryWithIngredients"
						}
					}
				},
				"required": ["_id", "name", "userId"]
			},
			"Note": {
				"type": "object",
				"properties": {
					"_id": {
						"type": "string"
					},
					"userId": {
						"type": "string"
					},
					"content": {
						"type": "string"
					},
					"createdAt": {
						"type": "string",
						"format": "date-time"
					},
					"updatedAt": {
						"type": "string",
						"format": "date-time"
					}
				},
				"required": ["_id", "userId", "content", "createdAt", "updatedAt"]
			},
			"NoteInput": {
				"type": "object",
				"properties": {
					"content": {
						"type": "string"
					}
				},
				"required": ["content"]
			},
			"RemoveTemplateInput": {
				"type": "object",
				"properties": {
					"userId": {
						"type": "string"
					}
				},
				"required": ["userId"]
			}
		}
	},
	"paths": {
		"/recommendations": {
			"get": {
				"summary": "Get dynamic recommendations",
				"parameters": [
					{
						"name": "date",
						"in": "query",
						"required": true,
						"schema": {
							"type": "string",
							"format": "date"
						}
					},
					{
						"name": "categoryId",
						"in": "query",
						"required": false,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Recommendations calculated successfully",
						"content": {
							"application/json": {
								"schema": {
									"type": "array",
									"items": {
										"$ref": "#/components/schemas/DynamicRecommendation"
									}
								}
							}
						}
					}
				}
			}
		},
		"/sets": {
			"get": {
				"summary": "Get sets",
				"parameters": [
					{
						"name": "offset",
						"in": "query",
						"schema": {
							"type": "integer"
						}
					},
					{
						"name": "limit",
						"in": "query",
						"schema": {
							"type": "integer"
						}
					},
					{
						"name": "startDate",
						"in": "query",
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "endDate",
						"in": "query",
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"type": "array",
									"items": {
										"$ref": "#/components/schemas/SetResponse"
									}
								}
							}
						}
					}
				}
			},
			"post": {
				"summary": "Create set",
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/SetInput"
							}
						}
					}
				},
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/SetCreationResponse"
								}
							}
						}
					}
				}
			}
		},
		"/sets/{id}": {
			"get": {
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/SetResponse"
								}
							}
						}
					}
				}
			},
			"put": {
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/SetUpdateInput"
							}
						}
					}
				},
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/SetUpdateResponse"
								}
							}
						}
					}
				}
			},
			"delete": {
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/SetDeleteResponse"
								}
							}
						}
					}
				}
			}
		},
		"/categories": {
			"get": {
				"parameters": [
					{
						"name": "offset",
						"in": "query",
						"schema": {
							"type": "integer"
						}
					},
					{
						"name": "limit",
						"in": "query",
						"schema": {
							"type": "integer"
						}
					},
					{
						"name": "all",
						"in": "query",
						"schema": {
							"type": "boolean"
						}
					},
					{
						"name": "showInTemplate",
						"in": "query",
						"schema": {
							"type": "boolean"
						}
					}
